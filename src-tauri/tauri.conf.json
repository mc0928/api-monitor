{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "api-monitor",
  "version": "0.2.0",
  "identifier": "com.local.apimonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "API Monitor",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMjRBMTQxN0YwNEM0NTAKUldSUXhBUi9RYUVrR2orZ2hkMXBOQmV4SGVmZmRlajBibmZMRW1YdVhVSldRV2tlblZ4bGNGR3EK",
      "endpoints": [
        "https://github.com/mc0928/api-monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
